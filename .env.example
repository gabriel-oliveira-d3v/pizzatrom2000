# ============================================================
#  PizzaTrom2000 — variáveis de ambiente
#  Copie para .env e preencha. NUNCA versione o .env.
# ============================================================

# ---------- Banco de dados ----------
# PostgreSQL do Neon (https://console.neon.tech → Connection Details)
# Use a URL "pooled" (termina com -pooler) e sslmode=verify-full
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-POOLER.REGIAO.aws.neon.tech/neondb?sslmode=verify-full

# ---------- Sessão ----------
# Segredo usado para assinar o cookie de sessão (qualquer texto longo e aleatório)
SESSION_SECRET=troque-por-um-texto-aleatorio-bem-grande

# ---------- Origens permitidas (CORS) ----------
# Separe por vírgula. Em desenvolvimento: http://localhost:3000
# Em produção: a URL do front na Vercel, ex.: https://pizzatrom2000.vercel.app
CORS_ORIGENS=http://localhost:3000

# ---------- IA (requisito 3) ----------
# Chave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite

# ---------- E-mail (requisito 11) ----------
# Chave: https://resend.com/api-keys
# Para testar sem configurar um domínio próprio, use o remetente
# de teste da Resend: onboarding@resend.dev (só entrega para o seu e-mail).
RESEND_API_KEY=
EMAIL_REMETENTE=onboarding@resend.dev

# ---------- Servidor ----------
PORT=3000
